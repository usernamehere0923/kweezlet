{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go",
  "main": "worker/index.ts",
  // Keep at or below what @cloudflare/vitest-pool-workers' bundled runtime supports,
  // or `npm test` fails with "requires compatibility date ..., but the newest date
  // supported by this server binary is ...".
  "compatibility_date": "2026-08-15",
  "observability": { "enabled": true },
  // The UI is served as static files. Only /api/* reaches the worker code;
  // every other unknown path gets index.html so the React router can handle it.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kweezlet",
      "database_id": "3dd73d1f-47bd-4f57-a955-f1e72a52ff7a",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": {
    "bindings": [{ "name": "USER_CHANNEL", "class_name": "UserChannel" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserChannel"] }],
}
